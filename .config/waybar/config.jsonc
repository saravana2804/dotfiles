{
  "layer": "top",

    "modules-left": [
        "sway/workspaces",
        "cava"
    ],
    "modules-center": [
         "clock"
    ],
    "modules-right": [
        "group/volume",
        "group/brightness",
        "network",
        "cpu",
        "memory",
        "battery"
    ],

    "sway/workspaces": {
            "disable-scroll": true,
            "all-outputs": true,
            "warp-on-scroll": false,
            "sort-by-number": true,
            "show-special": false,
            "format": "{name}",
            "persistent-workspaces": {
                "1": [],
                "2": [],
                "3": [],
                "4": [],
                "5": []
            }
        },

        "clock": {
          "format": "󰥔 {:%a, %d. %b %I:%M %p}",
          "tooltip-format": "<tt><small>{calendar}</small></tt>"
          },

    "cpu": {
      "interval": 10,
      "format": " {}%",
      "max-length": 10
    },

    "memory": {
      "interval": 30,
      "format": " {percentage}%",
      "tooltip-format": "{used:0.1f}G/{total:0.1f}G used"
    },

    "battery": {
      "interval": 60,
      "format": "{icon} {capacity}%",
      "format-icons": {
        "default": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"]
        }
    },

    "network": {
           "format": "",
           "format-wifi": "󰖩 {essid}",
           "format-ethernet": "",
           "format-disconnected": "󰖪",
           "tooltip-format": "{ifname} via {gwaddr} 󰊗",
           "tooltip-format-wifi": "{essid} ({signalStrength}%) 󰖩",
           "tooltip-format-ethernet": "{ifname} ",
           "tooltip-format-disconnected": "󰖪",
           "max-length": 50,
           "on-click": "exec nmrs"
    },

    "pulseaudio": {
           "format": "{volume}% {icon}",
           "format-muted": "",
           "format-icons": {
               "default": ["", ""]
           },
           "scroll-step": 1,
           "ignored-sinks": ["Easy Effects Sink"],
    },

    "pulseaudio/slider": {
           "min": 0,
           "max": 100,
           "orientation": "horizontal"
    },

    "group/volume": {
         "orientation": "horizontal",
         "modules": [
           "pulseaudio",
           "pulseaudio/slider"
         ]
    },

    "backlight": {
         "format": "{percent}% {icon}",
         "format-icons": ["", "󰃠"]
    },

    "backlight/slider": {
        "min": 0,
        "max": 100,
        "orientation": "horizontal"
    },

    "group/brightness": {
         "orientation": "horizontal",
         "modules": [
           "backlight",
           "backlight/slider"
         ]
    },

"cava": {
	"cava_config": "$XDG_CONFIG_HOME/cava/cava.conf",
	"framerate": 30,
	"autosens": 1,
	"sensitivity": 100,
	"bars": 14,
	"lower_cutoff_freq": 50,
	"higher_cutoff_freq": 10000,
	"method": "pulse",
	"source": "auto",
	"stereo": true,
	"reverse": false,
	"monstercat": false,
	"waves": false,
	"noise_reduction": 0.77,
	"input_delay": 4,
	"format-icons" : ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█" ],
	"actions": {
		"on-click-right": "mode"
	}
},

}
